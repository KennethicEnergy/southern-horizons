# --- Database (Neon Postgres) ---
# Use the pooled connection string from the Neon dashboard
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/southern_horizons?sslmode=require"

# --- Auth.js ---
# Generate with: pnpm dlx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Set to your production URL on Vercel, e.g. https://southernhorizons.org
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# --- Cloudflare R2 (media storage) ---
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="southern-horizons-media"
# Public bucket URL or custom domain connected to the bucket, e.g. https://media.southernhorizons.org
R2_PUBLIC_URL=""

# --- Seed admin (used by `pnpm db:seed` only) ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-please"
SEED_ADMIN_NAME="Site Admin"

# --- Site ---
SITE_URL="http://localhost:3000"
ORG_CITY="<insert city>"
